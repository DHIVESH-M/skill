DEMO_RATE_PER_HOUR=10
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
CORS_ORIGINS=https://skillpath-ai-theta.vercel.app,http://localhost:5173
QUIZ_SECRET=long-random-string   # signs/encrypts quiz tokens (falls back to the service key)
